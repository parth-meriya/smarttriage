# ==============================================================================
# SmartTriage Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global / Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=smarttriage-insecure-development-secret-key-change-in-production

# ------------------------------------------------------------------------------
# PostgreSQL Database (with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=smarttriage_db
POSTGRES_USER=smarttriage_user
POSTGRES_PASSWORD=smarttriage_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://smarttriage_user:smarttriage_secure_password@db:5432/smarttriage_db

# ------------------------------------------------------------------------------
# Redis & Celery
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Django Backend & Security
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=smarttriage.settings
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# AI Microservice (FastAPI + LLM Providers)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai_service:8001
LLM_PROVIDER=gemini
# LLM Provider Keys (provide at least one)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001/api/v1
PORT=3000
